# Обязательное: авторизационные данные GigaChat
GIGACHAT_CREDENTIALS=

# Необязательное
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
# в корпоративном контуре с самоподписанными сертификатами: false + путь к бандлу
GIGACHAT_VERIFY_SSL=true
# GIGACHAT_CA_BUNDLE=C:\certs\russian_trusted_root_ca.cer

# Пороги PoC (см. hr_agent/config.py)
# HR_RESPONSE_BUDGET=12
# HR_RUN_HARD_LIMIT=90
# HR_SYNTHETIC_LATENCY=0.15

# Трейсинг LangSmith выключен намеренно: в контур ушли бы табельные номера
LANGSMITH_TRACING=false
